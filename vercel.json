{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/internal/run-daily-pipeline",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/internal/cleanup-maintenance",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/internal/send-due-notifications",
      "schedule": "0 6,12,18 * * *"
    }
  ]
}
