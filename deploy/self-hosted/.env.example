# Copy to deploy/self-hosted/.env. This file is intentionally not used directly.
# Generate URL-safe secrets with: openssl rand -hex 32
POSTGRES_USER=nusift
POSTGRES_PASSWORD=REPLACE_WITH_A_64_CHARACTER_HEX_SECRET
APP_DATABASE_NAME=nusift
WORKFLOW_DATABASE_NAME=nusift_workflow

# App security and public URL
JWT_SECRET=REPLACE_WITH_A_DIFFERENT_64_CHARACTER_HEX_SECRET
CRON_SECRET=REPLACE_WITH_A_DIFFERENT_64_CHARACTER_HEX_SECRET
NUXT_PUBLIC_APP_URL=https://nusift.example.com

# Required for production browser fallback and push notifications.
NUXT_VAPID_PRIVATE_KEY=
NUXT_VAPID_SUBJECT=mailto:admin@example.com
NUXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional integrations copied from the current deployment when used.
NUXT_PUBLIC_GOOGLE_CLIENT_ID=
NUXT_PUBLIC_APPLE_CLIENT_ID=
RESEND_API_KEY=
NUXT_ADMIN_EMAILS=norbertkorom@gmail.com
NUXT_PIPELINE_VERBOSE_LOGS=false

# Conservative Dell defaults. Increase only after observing CPU and memory.
DATABASE_POOL_MAX=4
WORKFLOW_POSTGRES_WORKER_CONCURRENCY=2
WORKFLOW_POSTGRES_MAX_POOL_SIZE=4

# Add only after a Cloudflare Tunnel is created for the public hostname.
CLOUDFLARE_TUNNEL_TOKEN=
